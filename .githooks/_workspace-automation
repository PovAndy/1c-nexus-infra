#!/usr/bin/env sh
set -eu

event_name="${1:-manual}"
project_root="$(git rev-parse --show-toplevel)"
python_bin="${NEXUS_PYTHON_BIN:-$project_root/.venv-gemini-bridge/bin/python}"
graph_manager="$project_root/scripts/workspace_graph_v2_manager.py"
graph_guard="$project_root/scripts/precommit_graph_guard.py"
kb_manager="$project_root/scripts/kb_manager.py"

if [ ! -x "$python_bin" ]; then
    if command -v python3 >/dev/null 2>&1; then
        python_bin="$(command -v python3)"
    else
        echo "ОШИБКА: Python не найден; задайте NEXUS_PYTHON_BIN" >&2
        exit 1
    fi
fi

case "$event_name" in
    pre-commit)
        graph_lock="$project_root/temp/workspace_graph_v2.lock"
        if flock -n "$graph_lock" true; then
            "$python_bin" "$graph_guard" --root "$project_root" --lock-state idle
        else
            "$python_bin" "$graph_guard" --root "$project_root" --lock-state busy
        fi
        "$python_bin" "$kb_manager" --validate
        ;;
    pre-push)
        "$python_bin" "$graph_manager" ensure --deep --quiet --reason "git:pre-push"
        "$python_bin" "$kb_manager" --validate
        ;;
    post-checkout|post-merge|post-rewrite)
        if ! "$python_bin" "$graph_manager" ensure --quiet --reason "git:$event_name"; then
            echo "ПРЕДУПРЕЖДЕНИЕ: Graph V2 не обновлен после $event_name" >&2
        fi
        ;;
    *)
        echo "ОШИБКА: неизвестное событие автоматизации: $event_name" >&2
        exit 2
        ;;
esac
