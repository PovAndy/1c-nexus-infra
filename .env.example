# Linux/vrunner examples
V8_BIN=/opt/1cv8/x86_64/8.3.XX.XXXX/1cv8
IB_CONN=/F/home/papaandrey/1S/ib

# Shared credentials for Windows/WSL helper scripts
EPF_DB_USER=
EPF_DB_PWD=

# Backward-compatible aliases for shell scripts
DB_USER=
DB_PWD=

# Windows bridge baseline for this project
V8_WIN_BIN=C:\Program Files\1cv8\8.3.27.1964\bin\1cv8.exe

# Optional: v8 version, language, bitness
V8_VERSION=
LANG=ru
BITNESS=x64

# Cloud-role routing. WAN25 gateway is opt-in and uses one key only when enabled.
WAN25_GATEWAY_ENABLED=1
WAN25_API_KEY=
WAN25_RPM_LIMIT=10
WAN25_MIN_INTERVAL_SECONDS=6.0
WAN25_MAX_QUEUE_WAIT_SECONDS=18.0
CODER_API_BASE_URL=https://apiai.wan-2-5.pro/v1

# Models are provider catalog IDs, not OpenCode aliases.
ORCHESTRATOR_MODEL=openai/gpt-5.6-sol
ORCHESTRATOR_FALLBACK_MODEL=openai/gpt-5.6-luna
CODER_LUNA_MODEL=openai/gpt-5.6-luna
CODER_LUNA_FALLBACK_MODEL=claude-3-7-sonnet
CRITIC_MODEL=vanchin/deepseek-v4-pro
CRITIC_FALLBACK_MODEL=zhipu/glm-5-3
LIBRARIAN_MODEL=moonshot/kimi-k3
LIBRARIAN_FALLBACK_MODEL=qwen/qwen3.6-plus
SCRIBE_MODEL=qwen/qwen3.6-flash
SCRIBE_FALLBACK_MODEL=qwen/qwen3.6-plus
FORENSICS_MODEL=qwen/qwen3.6-plus
FORENSICS_FALLBACK_MODEL=zhipu/glm-5-3

# Individual rollback routes and role credentials stay active when gateway=0.
CODER_LUNA_API_BASE_URL=https://seekai.cc/v1
ORCHESTRATOR_API_BASE_URL=https://seekai.cc/v1
CRITIC_API_BASE_URL=https://openrouter.ai/api/v1
LIBRARIAN_API_BASE_URL=https://openrouter.ai/api/v1
SCRIBE_API_BASE_URL=https://openrouter.ai/api/v1
FORENSICS_API_BASE_URL=https://openrouter.ai/api/v1
CODER_LUNA_API_KEY=
CODER_LUNA_FALLBACK_API_KEY=
INSPECTOR_SOL_API_KEY=
INSPECTOR_SOL_FALLBACK_API_KEY=
CRITIC_API_KEY=
CRITIC_FALLBACK_API_KEY=
SCRIBE_API_KEY=
SCRIBE_FALLBACK_API_KEY=
OR_KEY_PAID_CHEAP=

# Optional local server alias: Srvr="localhost"; Ref="base02".
# Load these bridge settings from .env.openrouter.local. Credentials remain local.
# WSL_HOST_IP is an example placeholder; use the current Windows host address.
OMVL_1C_ALIAS_BASE02=base02
LDS_1C_BRIDGE_URL_BASE02=http://localhost/base02/hs/codex-test
LDS_1C_BRIDGE_URL_IP_BASE02=http://WSL_HOST_IP/base02/hs/codex-test
LDS_1C_BRIDGE_READ_ONLY_BASE02=1
RSVDATA_MCP_URL_BASE02=http://WSL_HOST_IP/base02/hs/rsvdata/mcp

# Dedicated PostgreSQL diagnostic credentials; never use the 1C application login.
EPF_SQL_RO_HOST=WSL_HOST_IP
EPF_SQL_RO_PORT=5432
EPF_SQL_RO_DB=base02
EPF_SQL_RO_USER=codex_sql_ro
EPF_SQL_RO_PWD=
