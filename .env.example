# 1c-nexus-infra: пример конфигурации (без реальных секретов).
# Скопируйте в .env и заполните под своё окружение.
# Секреты и конфиденциальные данные не публикуются и не коммитятся.

# Корень фреймворка. Если не задан, используется каталог модуля.
NEXUS_WORKSPACE_ROOT=

# RAG
NEXUS_KB_PATH=knowledge_base.json

# MCP: RSV Data HTTP-прокси (mock endpoints)
RSVDATA_MCP_URL=http://127.0.0.1:8080/hs/rsvdata/mcp
RSVDATA_USER=
RSVDATA_PASS=

# MCP: CodexTestBridge (mock endpoints)
LDS_1C_BRIDGE_URL=http://127.0.0.1:18080/test-bridge
LDS_1C_BRIDGE_TARGET=
LDS_1C_BRIDGE_AGENT=
LDS_1C_BRIDGE_PASS=

# Сетевая прослойка WSL/Windows (опционально)
LDS_NETWORK_PROXY_IP=
POWERSHELL_BIN=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe

# Пути к внешним валидаторам (опционально)
NEXUS_FORM_VALIDATOR=
NEXUS_PYTHON_BIN=

# Unified OpenAI-compatible WAN25 gateway (sanitized example).
# Set to 1 to route all configured OMVL roles through one gateway/key.
# Set to 0 to keep each role's own endpoint and credential slot.
WAN25_GATEWAY_ENABLED=0
WAN25_API_KEY=
CODER_API_BASE_URL=https://apiai.wan-2-5.pro/v1
WAN25_RPM_LIMIT=10
WAN25_MIN_INTERVAL_SECONDS=6.0
WAN25_MAX_QUEUE_WAIT_SECONDS=18.0

# Provider catalog IDs; OpenCode aliases are defined in opencode.example.json.
ORCHESTRATOR_MODEL=openai/gpt-5.6-sol
ORCHESTRATOR_FALLBACK_MODEL=openai/gpt-5.6-luna
CODER_LUNA_MODEL=openai/gpt-5.6-luna
CODER_LUNA_FALLBACK_MODEL=claude-3-7-sonnet
CRITIC_MODEL=vanchin/deepseek-v4-pro
CRITIC_FALLBACK_MODEL=zhipu/glm-5-3
LIBRARIAN_MODEL=moonshot/kimi-k3
LIBRARIAN_FALLBACK_MODEL=qwen/qwen3.6-plus
SCRIBE_MODEL=qwen/qwen3.6-flash
SCRIBE_FALLBACK_MODEL=qwen/qwen3.6-plus
FORENSICS_MODEL=qwen/qwen3.6-plus
FORENSICS_FALLBACK_MODEL=zhipu/glm-5-3

# Used only when WAN25_GATEWAY_ENABLED=0. Replace example URLs and fill secrets locally.
CODER_LUNA_API_BASE_URL=https://role-provider.example/v1
ORCHESTRATOR_API_BASE_URL=https://role-provider.example/v1
CRITIC_API_BASE_URL=https://role-provider.example/v1
LIBRARIAN_API_BASE_URL=https://role-provider.example/v1
SCRIBE_API_BASE_URL=https://role-provider.example/v1
FORENSICS_API_BASE_URL=https://role-provider.example/v1
CODER_LUNA_API_KEY=
CODER_LUNA_FALLBACK_API_KEY=
INSPECTOR_SOL_API_KEY=
INSPECTOR_SOL_FALLBACK_API_KEY=
CRITIC_API_KEY=
CRITIC_FALLBACK_API_KEY=
SCRIBE_API_KEY=
SCRIBE_FALLBACK_API_KEY=
OR_KEY_PAID_CHEAP=
